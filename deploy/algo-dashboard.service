[Unit]
Description=Algo Production Monitor Live Discord Dashboard
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/algo-dashboard
ExecStart=/home/pi/algo-dashboard/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Ensure environment variables are loaded
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
