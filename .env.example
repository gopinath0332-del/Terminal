# ==============================================================================
# ALGO DASHBOARD CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- Discord Bot Setup ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# How often (in seconds) the dashboard message refreshes in Discord
REFRESH_INTERVAL_SECONDS=20

# --- Auto-Discovery Paths to Existing Projects ---
# Keys are ALWAYS loaded directly from each respective project directory:
#
# 1. Delta Futures:  /home/pi/delta-exchange-alog/config/.env
# 2. Delta Options:  /home/pi/opt-algo/config/.env
# 3. Zerodha Kite:   /home/pi/nifty-strike-engine/.env
# 4. Nifty Swing:    /home/pi/nifty-portfolio

NIFTY_STRIKE_ENV_PATH=/home/pi/nifty-strike-engine/.env
NIFTY_PORTFOLIO_DIR=/home/pi/nifty-portfolio
DELTA_FUTURES_ENV_PATH=/home/pi/delta-exchange-alog/config/.env
DELTA_OPTIONS_ENV_PATH=/home/pi/opt-algo/config/.env
